# ----------------------------------------------------
# Tahrirchi Content Assistant Environment Variables
# ----------------------------------------------------
#
# INSTRUCTIONS:
# 1. Rename this file to .env
# 2. Fill in the values for your Telegram Bot.
# 3. Keep this file private and do not commit it to version control.

# -- Telegram API Configuration --
# Your Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# The unique identifier for the target chat (channel or group)
# For a public channel, it's "@channelusername"
# For a private channel or group, you need the chat ID (e.g., -1001234567890)
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"


# -- Server Configuration --
# The port the application will run on. Defaults to 3000 if not set.
PORT=3000


# -- WordPress API Configuration --
# The full URL to your WordPress site
WORDPRESS_URL="https://yourdomain.com"

# Your WordPress username
WORDPRESS_USERNAME="YOUR_WP_USERNAME"

# The Application Password you generated in your WordPress user profile
WORDPRESS_APP_PASSWORD="YOUR_WP_APPLICATION_PASSWORD"
